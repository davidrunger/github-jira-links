#!/usr/bin/env bash

set -euo pipefail # exit on any error, don't allow undefined variables, pipes don't swallow errors

ignore_files=$(git ls-files --others --ignored --exclude-standard | grep -Ev '^node_modules/')

if [ -n "$ignore_files" ] ; then
  ./node_modules/.bin/web-ext lint --warnings-as-errors --ignore-files $ignore_files
else
  ./node_modules/.bin/web-ext lint --warnings-as-errors
fi
